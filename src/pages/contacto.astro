---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto - Concha Lorente Pinturas" description="Contacta con Concha Lorente para consultas sobre obra, exposiciones o colaboraciones.">
  <div class="page-hero">
    <h1>Contacto</h1>
    <p>Para consultas sobre obra, adquisiciones o colaboraciones</p>
  </div>

  <div class="container">
    <div class="contact-content">
      <div class="contact-info">
        <div class="contact-block">
          <h2>Correo electrónico</h2>
          <p>Para consultas sobre obra, adquisiciones o colaboraciones:</p>
          <a href="mailto:conlogon@gmail.com" class="contact-link">conlogon@gmail.com</a>
        </div>

        <div class="contact-block">
          <h2>Tienda online</h2>
          <p>Puedes ver y adquirir obra original en mi tienda de Artelista:</p>
          <a href="http://conchalorente.artelista.com" target="_blank" rel="noopener noreferrer" class="contact-link">conchalorente.artelista.com</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-content {
    max-width: 600px;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .contact-block {
    margin-bottom: 3rem;
  }

  .contact-block h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .contact-block p {
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
    color: var(--color-text-light);
  }

  .contact-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 400;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
  }
</style>
