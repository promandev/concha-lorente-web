---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada - Concha Lorente">
  <div class="not-found">
    <h1>404</h1>
    <p>La página que buscas no existe.</p>
    <a href="/" class="btn btn-secondary">Volver al inicio</a>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 8rem 2rem;
  }

  .not-found h1 {
    font-size: 6rem;
    color: var(--color-text-light);
    font-weight: 300;
    margin-bottom: 1rem;
  }

  .not-found p {
    font-size: 1.2rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }
</style>
