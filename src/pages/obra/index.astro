---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { imgAt, imgSrcset } from '../../lib/img';

const obras = await getCollection('obras');
const obrasOrdenadas = obras.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// slug → label mapping (URLs in lowercase, clean)
const categorias = [
  { slug: 'estructuras',        label: 'Estructuras' },
  { slug: 'bocetos-y-dibujos',  label: 'Bocetos y dibujos' },
  { slug: 'primeras-etapas',    label: 'Primeras etapas' },
] as const;

// slug → raw value used in content frontmatter
const slugToCategoria: Record<string, string> = {
  'estructuras':       'ESTRUCTURAS',
  'bocetos-y-dibujos': 'BOCETOS Y DIBUJOS',
  'primeras-etapas':   'PRIMERAS ETAPAS',
};
---

<Layout title="Obra - Concha Lorente Pinturas" description="Galería completa de pinturas de Concha Lorente. Técnica mixta, acrílico, óleo y collage.">
  <div class="page-hero">
    <h1>Obra</h1>
    <p>Colección completa de pinturas organizadas por categoría</p>
  </div>

  <div class="container">
    <nav class="category-filter" aria-label="Filtrar por categoría">
      <a href="/obra" data-filter="todas">Todas</a>
      {categorias.map((cat) => (
        <a href={`/obra?categoria=${cat.slug}`} data-filter={cat.slug}>
          {cat.label}
        </a>
      ))}
    </nav>

    <div class="gallery-grid" id="obras-grid">
      {obrasOrdenadas.map((obra, i) => {
        const categoriaSlug = Object.entries(slugToCategoria).find(
          ([, v]) => v === obra.data.categoria
        )?.[0] ?? '';
        return (
          <article class="obra-card" data-categoria={categoriaSlug}>
            <a href={`/obra/${obra.id.replace(/\.md$/, '')}`}>
              <div class="obra-card-image">
                <img
                  src={imgAt(obra.data.imagen, 800)}
                  srcset={imgSrcset(obra.data.imagen)}
                  sizes="(max-width: 640px) 100vw, 380px"
                  alt={obra.data.titulo}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </div>
              <div class="obra-card-info">
                <h3 class="obra-card-title">{obra.data.titulo}</h3>
                <p class="obra-card-technique">{obra.data.tecnica} ({obra.data.dimensiones})</p>
                <span class="obra-card-category">{obra.data.categoria}</span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  function applyFilter() {
    const param = new URLSearchParams(window.location.search).get('categoria') ?? 'todas';

    // Mark active filter button
    document.querySelectorAll<HTMLAnchorElement>('.category-filter a').forEach((a) => {
      a.classList.toggle('active', (a.dataset.filter ?? '') === param);
    });

    // Show / hide cards
    document.querySelectorAll<HTMLElement>('#obras-grid .obra-card').forEach((card) => {
      const match = param === 'todas' || card.dataset.categoria === param;
      card.style.display = match ? '' : 'none';
    });
  }

  // Run on page load
  applyFilter();

  // Handle browser back/forward without reload
  window.addEventListener('popstate', applyFilter);

  // Intercept filter link clicks — update URL without full reload
  document.querySelectorAll<HTMLAnchorElement>('.category-filter a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const url = new URL(a.href, window.location.href);
      window.history.pushState({}, '', url);
      applyFilter();
    });
  });
</script>
