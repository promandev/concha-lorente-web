---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { imgAt, imgSrcset } from '../../lib/img';
import { getDimensiones } from '../../lib/dimensiones';

// Salas, en el orden en que se cuelgan. `categoria` es el valor del frontmatter.
const series = [
  { slug: 'estructuras', label: 'Estructuras', categoria: 'ESTRUCTURAS' },
  { slug: 'primeras-etapas', label: 'Primeras etapas', categoria: 'PRIMERAS ETAPAS' },
  { slug: 'bocetos-y-dibujos', label: 'Bocetos y dibujos', categoria: 'BOCETOS Y DIBUJOS' },
] as const;

// Más reciente primero dentro de cada sala.
const obras = (await getCollection('obras')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

const salas = (
  await Promise.all(
    series.map(async (serie) => ({
      ...serie,
      obras: await Promise.all(
        obras
          .filter((o) => o.data.categoria === serie.categoria)
          .map(async (o) => {
            const { width, height } = await getDimensiones(o.data.imagen, o.data.titulo);
            return { obra: o, ratio: width / height };
          })
      ),
    }))
  )
).filter((sala) => sala.obras.length > 0); // una serie sin obras no genera sala

// Las primeras obras de la primera sala se cargan con prioridad.
let posicion = 0;
---

<Layout title="Obra - Concha Lorente Pinturas" description="Galería completa de pinturas de Concha Lorente. Técnica mixta, acrílico, óleo y collage.">
  <div class="page-hero">
    <h1>Obra</h1>
    <p>Colección completa de pinturas organizadas por categoría</p>
  </div>

  <div class="container">
    <nav class="category-filter" aria-label="Ir a una serie">
      {salas.map((sala) => (
        <a href={`#${sala.slug}`}>{sala.label}</a>
      ))}
    </nav>

    {salas.map((sala) => (
      <section class="sala" id={sala.slug} aria-labelledby={`sala-${sala.slug}`}>
        <h2 class="sala-titulo" id={`sala-${sala.slug}`}>{sala.label}</h2>
        <div class="pared">
          {sala.obras.map(({ obra, ratio }) => {
            const prioridad = posicion++ < 6;
            return (
              <article class="pared-obra" style={`--ratio:${ratio.toFixed(4)}`}>
                <a href={`/obra/${obra.id.replace(/\.md$/, '')}`}>
                  <div class="pared-obra-img">
                    <img
                      src={imgAt(obra.data.imagen, 800)}
                      srcset={imgSrcset(obra.data.imagen)}
                      sizes={`(max-width: 640px) 100vw, ${Math.round(ratio * 360)}px`}
                      alt=""
                      loading={prioridad ? 'eager' : 'lazy'}
                      fetchpriority={posicion === 1 ? 'high' : undefined}
                      decoding="async"
                    />
                  </div>
                  <div class="pared-obra-cartela">
                    <h3 class="pared-obra-titulo">{obra.data.titulo}</h3>
                    <p class="pared-obra-datos">{obra.data.tecnica}, {obra.data.dimensiones} cm</p>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  // Compatibilidad con los enlaces antiguos /obra?categoria=<serie>: llevan a la sala
  // de esa serie. Un valor desconocido se ignora y el catálogo se muestra desde el principio.
  const categoria = new URLSearchParams(window.location.search).get('categoria');
  const sala = categoria ? document.getElementById(categoria) : null;
  if (sala?.classList.contains('sala')) {
    history.replaceState(null, '', `${window.location.pathname}#${categoria}`);
    sala.scrollIntoView({ behavior: 'auto' });
  }
</script>
