---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { imgAt, imgSrcset } from '../lib/img';

const obras = await getCollection('obras');
const obrasOrdenadas = obras.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const destacadas = obrasOrdenadas.slice(0, 6);
// Portada: la primera obra con `portada: true`; si no hay ninguna, la más reciente.
const portada = obrasOrdenadas.find((o) => o.data.portada) ?? obrasOrdenadas[0];
const portadaSlug = portada.id.replace(/\.md$/, '');
// La banda "Sobre la artista" usa otra obra distinta de la portada.
const aboutObra = obrasOrdenadas.filter((o) => o.id !== portada.id)[2] ?? obrasOrdenadas[1];
---

<Layout title="Concha Lorente - Pinturas">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-intro">
      <h1>Concha Lorente</h1>
      <p class="hero-subtitle">Pinturas</p>
    </div>
    <figure class="hero-work">
      <a href={`/obra/${portadaSlug}`} class="hero-work-frame" aria-label={`Ver la obra ${portada.data.titulo}`}>
        <img
          src={imgAt(portada.data.imagen, 1200)}
          srcset={imgSrcset(portada.data.imagen, [600, 900, 1200, 1600])}
          sizes="(max-width: 768px) 100vw, 900px"
          alt={`${portada.data.titulo}, de Concha Lorente: ${portada.data.tecnica}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
      <figcaption class="hero-work-caption">
        <a href={`/obra/${portadaSlug}`} class="hero-work-title">{portada.data.titulo}</a>
        <span class="hero-work-meta">{portada.data.tecnica}, {portada.data.dimensiones} cm</span>
      </figcaption>
    </figure>
    <blockquote class="hero-quote">
      "La sintetización geométrica de sus formas junto con la tonalidad que emplea, da como resultado armonía y poética en la composición. Con lo que la obra de Concha Lorente se convierte en una sutil y bella abstracción".
      <cite>— D. Antonio Granados Valdés, miembro de la Asociación de Críticos de Arte Madrileña, Española e Internacional</cite>
    </blockquote>
    <a href="/obra" class="btn">Ver obra completa</a>
  </section>

  <!-- OBRAS DESTACADAS -->
  <section class="featured-section">
    <div class="container">
      <h2 class="section-title">Obra reciente</h2>
      <p class="section-subtitle">Selección de las últimas creaciones</p>
      <div class="gallery-grid">
        {destacadas.map((obra, i) => (
          <article class="obra-card">
            <a href={`/obra/${obra.id.replace(/\.md$/, '')}`}>
              <div class="obra-card-image">
                <img
                  src={imgAt(obra.data.imagen, 800)}
                  srcset={imgSrcset(obra.data.imagen)}
                  sizes="(max-width: 640px) 100vw, 380px"
                  alt={obra.data.titulo}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              </div>
              <div class="obra-card-info">
                <h3 class="obra-card-title">{obra.data.titulo}</h3>
                <p class="obra-card-technique">{obra.data.tecnica} ({obra.data.dimensiones})</p>
                <span class="obra-card-category">{obra.data.categoria}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <div class="section-cta">
        <a href="/obra" class="btn btn-secondary">Ver todas las obras</a>
      </div>
    </div>
  </section>

  <!-- SOBRE LA ARTISTA -->
  <section class="about-preview">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <h2>Sobre la artista</h2>
          <p>Pintora nacida en Madrid. Miembro de la Asociación Española de Pintores y Escultores.</p>
          <p>Su obra se caracteriza por la sintetización geométrica, el uso de técnica mixta y una paleta tonal que combina armonía y poética en cada composición.</p>
          <a href="/sobre-mi" class="text-link">Conocer más →</a>
        </div>
        <div class="about-image">
          <img
            src={imgAt(aboutObra.data.imagen, 800)}
            srcset={imgSrcset(aboutObra.data.imagen)}
            sizes="(max-width: 768px) 100vw, 560px"
            alt={`${aboutObra.data.titulo}, de Concha Lorente: ${aboutObra.data.tecnica}`}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.5rem 2rem 4rem;
  }

  .hero-intro {
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 300;
    letter-spacing: 0.05em;
    line-height: 1.2;
    animation: fadeInUp 0.9s ease both;
    animation-delay: 0.05s;
  }

  .hero-subtitle {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--color-text-light);
    animation: fadeInUp 0.9s ease both;
    animation-delay: 0.22s;
  }

  .hero-work {
    width: 100%;
    max-width: 900px;
    animation: fadeInUp 0.9s ease both;
    animation-delay: 0.4s;
  }

  /* Marco de altura fija: la obra se ve entera (contain) sobre un paspartú de
     Sage Mist y el espacio queda reservado antes de cargar la imagen. */
  .hero-work-frame {
    display: block;
    height: min(58vh, 520px);
    background: var(--color-mist);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hero-work-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-work-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-top: 1rem;
  }

  .hero-work-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .hero-work-meta {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .hero-quote {
    max-width: 640px;
    margin: 3rem 0 2rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.8;
    border: none;
    padding: 0;
    animation: fadeInUp 0.9s ease both;
    animation-delay: 0.6s;
  }

  .hero-quote cite {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    color: var(--color-text-light);
    margin-top: 0.75rem;
    font-family: var(--font-body);
  }

  .hero .btn {
    animation: fadeInUp 0.9s ease both;
    animation-delay: 0.75s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1,
    .hero-subtitle,
    .hero-work,
    .hero-quote,
    .hero .btn {
      animation: fadeIn 0.25s ease both;
      animation-delay: 0s;
    }
  }

  .featured-section {
    padding: 5rem 0;
  }

  .section-cta {
    text-align: center;
    margin-top: 3rem;
  }

  .about-preview {
    padding: 5rem 0;
    background: var(--color-white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text h2 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .about-text p {
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .text-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 400;
  }

  .about-image {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-mist);
    border-radius: var(--radius-md);
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .about-image:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 1.5rem 1rem 3rem;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-work-frame {
      height: min(58vh, 120vw);
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-text h2 {
      font-size: 1.8rem;
    }
  }
</style>
